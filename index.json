<script>
    function toIsoString(date) {
        var tzo = -date.getTimezoneOffset(),
            dif = tzo >= 0 ? '+' : '-',
            pad = function(num) {
                return (num < 10 ? '0' : '') + num;
            };

        return pad(date.getDate()) +
            '/' + pad(date.getMonth() + 1) +
            '/' + date.getFullYear() +
            't' + pad(date.getHours()) +
            ':' + pad(date.getMinutes()) +
            ':' + pad(date.getSeconds()) +
            '.' + date.getMilliseconds() +
            dif + pad(Math.floor(Math.abs(tzo) / 60)) +
            ':' + pad(Math.abs(tzo) % 60) + ':' + pad(Math.abs(tzo) % 60);
    }

